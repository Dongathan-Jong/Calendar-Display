void getStock()
{
  HTTPClient http;

  String url = "https://finnhub.io/api/v1/quote?symbol=NOK&token=";

  http.begin(url);
  int httpCode = http.GET();

  if(httpCode > 0)
  {
    String payload = http.getString();

    DynamicJsonDocument doc(2048);
    DeserializationError error = deserializeJson(doc, payload);

    if(!error)
    {
      stockData1[0] = doc["c"];
      stockData1[1] = doc["d"];
